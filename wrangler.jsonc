{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "play",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat"],

  // Static React build. The Worker runs first for /api/* and /ws so that the
  // SPA fallback never swallows API traffic; everything else is served from
  // the built client assets.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws"]
  },

  "durable_objects": {
    "bindings": [
      { "name": "EVENT_ROOM", "class_name": "EventRoom" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["EventRoom"] }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mystery-rush-db",
      "database_id": "984ffb0e-cc9d-423b-a945-7695aa61e247"
    }
  ],

  "observability": { "enabled": true }
}
