{
  "name": "mystery-rush",
  "version": "1.0.0",
  "private": true,
  "description": "Mystery Rush - a live multiplayer 'Guess the Mystery' game show for company events.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n WORKER,VITE -c magenta,cyan \"npm:dev:worker\" \"npm:dev:client\"",
    "dev:worker": "wrangler dev --port 8787",
    "dev:client": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "preview": "npm run build && wrangler dev --port 8787",
    "db:init:local": "wrangler d1 execute mystery-rush-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute mystery-rush-db --remote --file=./schema.sql",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wrangler": "^4.130.0"
  }
}
